# Database Configuration
MYSQL_DATABASE=livic
MYSQL_USER=livic
MYSQL_PASSWORD=secure_password_here
MYSQL_ROOT_PASSWORD=root_password_here

# Backend Security
APP_JWT_SECRET=your_32_character_secret_key_here
APP_CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# Spring Profiles
SPRING_PROFILES_ACTIVE=prod

# AI Configuration
APP_AI_ENABLED=false
SPRING_AI_MODEL_CHAT=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

# Push Notifications (Expo)
PUSH_ENABLED=false

# Email Notifications (SMTP / Gmail / SendGrid / Resend)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_ADDRESS=notifications@livic.com

# MSG91 (WhatsApp & SMS - India)
MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_SENDER_ID=LIVIC
MSG91_SMS_ENABLED=false
# One MSG91 flow per DLT template (docs/NOTIFICATION_CREDENTIALS_SETUP_GUIDE.md)
MSG91_SMS_FLOW_MARKETPLACE_OTP=
MSG91_SMS_FLOW_TOUR_APPROVED=
MSG91_SMS_FLOW_TOUR_DECLINED=
MSG91_SMS_FLOW_TOUR_REMINDER=
# Production refuses to start with SMS disabled unless this is false
MSG91_SMS_REQUIRED=
# Public marketplace URL used in SMS links
MARKETPLACE_BASE_URL=http://localhost:3000
MSG91_WHATSAPP_ENABLED=false
MSG91_WHATSAPP_INTEGRATED_NUMBER=

# Meta Direct WhatsApp Cloud API (Alternative)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

