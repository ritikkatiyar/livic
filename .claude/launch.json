{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landlord-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--max-old-space-size=8192",
        "node_modules/expo/bin/cli",
        "start",
        "--web",
        "--offline",
        "--port",
        "8081"
      ],
      "cwd": "livic-landlord-fe",
      "port": 8081,
      "url": "http://localhost:8081"
    },
    {
      "name": "backend",
      "runtimeExecutable": "mvn",
      "runtimeArgs": [
        "spring-boot:run",
        "-Dspring-boot.run.profiles=dev"
      ],
      "cwd": "backend",
      "port": 8080,
      "url": "http://localhost:8080"
    }
  ]
}
